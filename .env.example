# Copie para .env (não é versionado) antes de subir com docker compose.
# Senha do Postgres — use algo longo e aleatório, ex.: openssl rand -hex 24
DB_PASSWORD=troque-esta-senha

# 1 somente quando o site for servido por HTTPS (senão o login não grava cookie).
COOKIE_SECURE=0

# 1 reativa as contas de demonstração sem senha. Mantenha 0 em produção.
AUTH_CONTAS_DEMO=0

# Endereço público do sistema (links de termo enviados aos clientes). Ex.: https://gridlap.com.br
URL_PUBLICA=

# Banco na nuvem (Supabase): DATABASE_SSL=1 liga SSL com verificacao do certificado;
# DATABASE_CA = certificado da CA do provedor (PEM). Use a URL do "Session pooler"
# (porta 5432), sem ?sslmode=. Com docker compose deixe vazio.
DATABASE_SSL=
DATABASE_CA=
