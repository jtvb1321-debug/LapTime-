# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# dados locais persistidos pelo servidor (sem Supabase ainda)
/.data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backups do banco (docker-compose)
/backups
!.env.example

# logs do servidor local
gridlap-local*.log

# coletor de decoders (configuração, fila e capturas são locais)
coletor/config.json
coletor/fila.jsonl*
coletor/capturas/
coletor/agente.json
coletor/dist/
coletor/GridLap-Agente.log
.tunel-local.cmd
.servidor-local.cmd
